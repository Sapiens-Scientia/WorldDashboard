{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/metrics.js": {
      "maxDuration": 30,
      "includeFiles": "src/data/snapshot.json"
    }
  },
  "git": {
    "deploymentEnabled": true
  }
}
